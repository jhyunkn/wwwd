---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const entries = (await getCollection('entries', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const investigations = entries.filter((entry) => entry.data.contentType === 'Investigation');
const notes = entries.filter((entry) => entry.data.contentType === 'Note');
const featured = investigations[0];
const featuredUrl = featured ? `/investigations/${featured.id}/` : '/investigations/';
const proofItems = [featured, ...notes].filter(Boolean).slice(0, 4);
---

<BaseLayout title="WWWD" description="WWWD turns spatial claims into investigations, artifacts, and consequences.">
  <section class="hero frame">
    <p class="eyebrow">What would we do?</p>
    <h1>Architecture begins where the situation becomes accountable.</h1>
    <div class="hero-grid">
      <p>
        WWWD is an office for spatial investigations. It starts before the object, studies the pressures around a project, and builds artifacts that change how a relationship can be read, used, or acted on.
      </p>
      <a class="primary-link" href={featuredUrl}>Read the first Investigation</a>
    </div>
  </section>

  {featured && (
    <section class="flagship frame" aria-labelledby="flagship-title">
      <div class="flagship-copy">
        <p class="eyebrow">Flagship Investigation</p>
        <h2 id="flagship-title">{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <a class="text-link" href={featuredUrl}>Open the evidence sequence</a>
      </div>
      <a class="flagship-image" href={featuredUrl} aria-label={`Open ${featured.data.title}`}>
        <img src={featured.data.hero} alt={featured.data.heroAlt} loading="eager" />
      </a>
    </section>
  )}

  <section class="thesis-band" id="office" aria-labelledby="office-title">
    <div class="frame split">
      <p class="eyebrow">Office thesis</p>
      <div>
        <h2 id="office-title">Not a catalog. A body of arguments.</h2>
        <p>
          WWWD treats evidence as part of authorship: drawings, models, photographs, texts, material tests, site observations, and references are how a thesis is tested. A project should be accountable to a position before it becomes portfolio content.
        </p>
      </div>
    </div>
  </section>

  <section class="frame chain" aria-labelledby="chain-title">
    <p class="eyebrow">Content model</p>
    <h2 id="chain-title">Claim to Investigation to Artifact to Consequence.</h2>
    <div class="chain-grid">
      <article>
        <span>01</span>
        <h3>Claim</h3>
        <p>The position the work is willing to defend.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Investigation</h3>
        <p>The method, site reading, precedent, model, or fieldwork that tests the claim.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Artifact</h3>
        <p>The drawing, model, image, text, assembly, prototype, or built move produced by the inquiry.</p>
      </article>
      <article>
        <span>04</span>
        <h3>Consequence</h3>
        <p>The relationship the artifact changes outside the page.</p>
      </article>
    </div>
  </section>

  <section class="work-field frame" aria-labelledby="work-title">
    <div class="section-head">
      <p class="eyebrow">Review surface</p>
      <h2 id="work-title">First content pass.</h2>
      <p>Chankillo is converted as an Investigation. The rest remain labeled as Notes until they earn external consequence.</p>
    </div>
    <div class="work-grid">
      {proofItems.map((entry) => (
        <a class={entry.data.contentType === 'Investigation' ? 'work-item investigation' : 'work-item'} href={entry.data.contentType === 'Investigation' ? `/investigations/${entry.id}/` : `/notes/${entry.id}/`}>
          <img src={entry.data.hero} alt="" loading="lazy" />
          <span>{entry.data.contentType} / {entry.data.discipline}</span>
          <strong>{entry.data.title}</strong>
          <em>{entry.data.description}</em>
        </a>
      ))}
    </div>
  </section>

  <section class="gate-band" id="gate" aria-labelledby="gate-title">
    <div class="frame gate">
      <p class="eyebrow">Publish gate</p>
      <h2 id="gate-title">No external consequence, no Investigation.</h2>
      <ul>
        <li>Claim: the defensible position.</li>
        <li>Investigation: the inquiry that tests it.</li>
        <li>Artifact: the produced spatial evidence.</li>
        <li>Consequence: what changes because the artifact exists.</li>
        <li>External consequence: who or what outside the page is affected.</li>
      </ul>
    </div>
  </section>

  <section class="notes-band frame" aria-labelledby="notes-title">
    <p class="eyebrow">Notes long-tail</p>
    <div>
      <h2 id="notes-title">Promising work stays visible without passing as finished argument.</h2>
      <p>
        Notes preserve source material, questions, and conversion pressure. They become Investigations only when the external consequence is strong enough to defend.
      </p>
      <a class="text-link" href="/notes/">Review all Notes</a>
    </div>
  </section>
</BaseLayout>
