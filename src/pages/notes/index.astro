---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const notes = (await getCollection(
  'entries',
  ({ data }) => data.contentType === 'Note' && data.status === 'published',
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Notes" description="WWWD notes hold candidate work until it earns the external consequence required for an Investigation.">
  <section class="page-hero frame">
    <p class="eyebrow">Notes</p>
    <h1>Candidate work, kept under pressure.</h1>
    <p>Notes are public enough to review and disciplined enough not to impersonate completed Investigations.</p>
  </section>

  <section class="entry-list frame" aria-label="Notes">
    {notes.map((entry) => (
      <a class="entry-row" href={`/notes/${entry.id}/`}>
        <span>{entry.data.contentType} / {entry.data.discipline}</span>
        <strong>{entry.data.title}</strong>
        <em>{entry.data.description}</em>
      </a>
    ))}
  </section>
</BaseLayout>
