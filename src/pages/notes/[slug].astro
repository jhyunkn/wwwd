---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection(
    'entries',
    ({ data }) => data.contentType === 'Note' && data.status === 'published',
  );
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.hero}>
  <article class="note-page">
    <section class="investigation-hero frame">
      <a class="back-link" href="/notes/">Back to notes</a>
      <p class="eyebrow">{entry.data.contentType} / {entry.data.discipline}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <img src={entry.data.hero} alt={entry.data.heroAlt} loading="eager" />
    </section>

    <section class="note-gate frame" aria-label="Investigation gate status">
      <span>Gate status</span>
      <p>This work remains a Note until its external consequence is specific enough to defend as a public Investigation.</p>
    </section>

    <section class="article-body frame">
      <Content />
    </section>

    <section class="image-sequence frame" aria-label="Working evidence">
      {entry.data.images.map((image) => (
        <figure>
          <img src={image.src} alt={image.alt} loading="lazy" />
          <figcaption><span>{image.role}</span>{image.caption}</figcaption>
        </figure>
      ))}
    </section>
  </article>
</BaseLayout>
